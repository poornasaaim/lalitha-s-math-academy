# Copy this file to .env and fill in your values
# -------------------------------------------------

# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CREDENTIALS_FILE=credentials.json

# Flask
FLASK_SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_chars
FLASK_ENV=development

# Admin (also stored in GSheets, this is a fallback)
ADMIN_PASSWORD=admin123

# Academy WhatsApp number (with country code, no + or spaces)
ACADEMY_WHATSAPP=919841260450

# CallMeBot API key (get free from https://www.callmebot.com/blog/free-api-whatsapp-messages/)
# Leave empty to use wa.me links only
CALLMEBOT_API_KEY=

# Google Maps Embed API Key (free tier)
GOOGLE_MAPS_API_KEY=AIzaSyD-SAMPLE-KEY-REPLACE-ME
